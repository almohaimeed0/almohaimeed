/* =====================================================================
   MATCHING ENGINE
   (لم يتغير — المسودات لا تشارك)
===================================================================== */
function computeMatch(offer, request){
  if(offer.type !== request.type) return null;
  if(offer.status !== 'متاح') return null;
  if(request.status !== 'نشط') return null;

  let score = 0;
  const reasons = [];

  // location
  if(offer.city === request.city){
    if(!request.neighborhood || offer.neighborhood === request.neighborhood){
      score += 40; reasons.push({label: request.neighborhood ? 'نفس الحي' : 'نفس المدينة', weak:false});
    }else{
      score += 20; reasons.push({label:'نفس المدينة فقط', weak:true});
    }
  }

  // budget
  const min = request.budgetMin || 0;
  const max = request.budgetMax;
  if(offer.price >= min && offer.price <= max){
    score += 35; reasons.push({label:'ضمن الميزانية', weak:false});
  }else if(offer.price <= max * 1.1){
    score += 18; reasons.push({label:'قريب من الميزانية', weak:true});
  }

  // area
  if(request.areaMin || request.areaMax){
    const aMin = request.areaMin || 0;
    const aMax = request.areaMax || Infinity;
    if(offer.area >= aMin && offer.area <= aMax){
      score += 25; reasons.push({label:'ضمن المساحة المطلوبة', weak:false});
    }else if(offer.area >= aMin*0.85 && offer.area <= aMax*1.15){
      score += 12; reasons.push({label:'مساحة قريبة', weak:true});
    }
  }else{
    score += 12; reasons.push({label:'لا قيد على المساحة', weak:true});
  }

  if(score < 30) return null;
  return { score: Math.min(score,100), reasons };
}

function computeAllMatches(){
  const groups = [];
  requests.filter(r=>r.status==='نشط').forEach(r=>{
    const matches = [];
    offers.filter(o=>o.status==='متاح').forEach(o=>{
      const m = computeMatch(o,r);
      if(m) matches.push({ offer:o, score:m.score, reasons:m.reasons });
    });
    matches.sort((a,b)=>b.score-a.score);
    if(matches.length) groups.push({ request:r, matches });
  });
  groups.sort((a,b)=> Math.max(...b.matches.map(m=>m.score)) - Math.max(...a.matches.map(m=>m.score)));
  return groups;
}

function stampClass(score){
  if(score>=70) return 'high';
  if(score>=45) return 'mid';
  return 'low';
}

function renderMatches(){
  const groups = computeAllMatches();
  const el = document.getElementById('matchesList');
  if(!groups.length){
    el.innerHTML = `<div class="panel">${emptyStateHtml('لا توجد مطابقات حاليًا', 'أضِف عروضًا وطلبات نشطة من نفس نوع العقار لبدء المطابقة التلقائية.')}</div>`;
    return;
  }
  el.innerHTML = groups.map(g => `
    <div class="match-group">
      <div class="match-req-head">
        <div>
          <div class="rtitle">طلب ${escapeHtml(g.request.type)} — ${escapeHtml(g.request.clientName)}</div>
          <div class="rsub">${escapeHtml(g.request.city)}${g.request.neighborhood ? ' / ' + escapeHtml(g.request.neighborhood) : ''} · حتى ${fmtMoney(g.request.budgetMax)} ريال · ${g.request.clientPhone}</div>
        </div>
        <span class="badge badge-active">نشط</span>
      </div>
      <div class="match-list">
        ${g.matches.map(m => `
          <div class="match-row">
            <div class="stamp ${stampClass(m.score)}">
              <div class="pct">${m.score}%</div>
              <div class="lbl">تطابق</div>
            </div>
            <div class="match-row-info">
              <div class="mtitle">${escapeHtml(m.offer.type)} — ${escapeHtml(m.offer.neighborhood)}, ${escapeHtml(m.offer.city)}</div>
              <div class="mmeta">${fmtMoney(m.offer.price)} ريال · ${fmtMoney(m.offer.area)} م² · ${escapeHtml(m.offer.ownerName)} (${escapeHtml(m.offer.ownerPhone)})</div>
              <div class="match-reasons">
                ${m.reasons.map(r=>`<span class="reason-chip ${r.weak?'weak':''}">${r.label}</span>`).join('')}
              </div>
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');
}

