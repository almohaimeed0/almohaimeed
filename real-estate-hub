function renderDrafts(){
  const el = document.getElementById('draftsList');
  const draftOffers = offers.filter(o=>o.status==='مسودة').sort((a,b)=>b.createdAt-a.createdAt);
  const draftRequests = requests.filter(r=>r.status==='مسودة').sort((a,b)=>b.createdAt-a.createdAt);
  const items = [];

  draftOffers.forEach(o=>{
    items.push(offerCardHtml(o));
  });
  draftRequests.forEach(r=>{
    items.push(requestCardHtml(r));
  });

  if(items.length === 0){
    el.innerHTML = emptyStateHtml('لا توجد مسودات', 'احفظ عروضًا أو طلبات كمسودة لتراها هنا.');
  }else{
    el.innerHTML = items.join('');
  }
}

