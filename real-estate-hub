    status: document.getElementById('reqStatus').value,
    areaMin: document.getElementById('reqAreaMin').value ? Number(document.getElementById('reqAreaMin').value) : null,
    areaMax: document.getElementById('reqAreaMax').value ? Number(document.getElementById('reqAreaMax').value) : null,
    budgetMin: document.getElementById('reqBudgetMin').value ? Number(document.getElementById('reqBudgetMin').value) : null,
    budgetMax: Number(document.getElementById('reqBudgetMax').value),
    city: document.getElementById('reqCity').value.trim(),
    neighborhood: document.getElementById('reqNeighborhood').value.trim(),
    clientName: document.getElementById('reqClientName').value.trim(),
    clientPhone: document.getElementById('reqClientPhone').value.trim(),
