<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سجلّ | منصة العروض والطلبات العقارية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#172033;
    --ink-soft:#2B3448;
    --paper:#F1F2ED;
    --panel:#FFFFFF;
    --brass:#A9824C;
    --brass-dark:#8C6A3B;
    --emerald:#2F6E5C;
    --emerald-bg:#E4EFEA;
    --rust:#A3462F;
    --rust-bg:#F5E7E2;
    --amber:#B08A2E;
    --amber-bg:#F5EEDD;
    --slate:#5B6572;
    --slate-soft:#8A93A0;
    --line:#DDD9CF;
    --line-soft:#E9E7E0;
    --radius:10px;
    --font-display:'Tajawal', sans-serif;
    --font-body:'IBM Plex Sans Arabic', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family:var(--font-body);
    background:var(--paper);
    color:var(--ink);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{ background:var(--brass); color:#fff; }
  button{ font-family:inherit; cursor:pointer; }
  input, select, textarea{ font-family:inherit; }

  /* ---------- Auth screen ---------- */
  #authScreen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:
      radial-gradient(circle at 15% 20%, rgba(169,130,76,0.08), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(47,110,92,0.08), transparent 40%),
      var(--paper);
  }
  .auth-card{
    width:100%;
    max-width:420px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:36px 32px;
    box-shadow:0 20px 50px -20px rgba(23,32,51,0.25);
  }
  .brand{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:28px;
  }
  .brand-mark{
    width:44px; height:44px;
    border:2px solid var(--ink);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-display); font-weight:900; font-size:18px;
    flex-shrink:0;
  }
  .brand-text h1{ font-family:var(--font-display); font-weight:900; font-size:20px; letter-spacing:0.5px;}
  .brand-text p{ font-size:12px; color:var(--slate); margin-top:2px;}

  .auth-tabs{ display:flex; border-bottom:1px solid var(--line); margin-bottom:22px; }
  .auth-tab{
    flex:1; text-align:center; padding:10px 0; background:none; border:none;
    font-size:14px; color:var(--slate-soft); font-weight:600; border-bottom:2px solid transparent;
    transition:.15s;
  }
  .auth-tab.active{ color:var(--ink); border-bottom-color:var(--brass); }

  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:13px; color:var(--slate); margin-bottom:6px; font-weight:500;}
  .field input, .field select, .field textarea{
    width:100%; padding:11px 13px; border:1px solid var(--line); border-radius:8px;
    font-size:14px; background:#FCFCFA; color:var(--ink); transition:.15s;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-color:var(--brass); background:#fff;
    box-shadow:0 0 0 3px rgba(169,130,76,0.12);
  }
  .field-row{ display:flex; gap:12px; }
  .field-row .field{ flex:1; }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:11px 18px; border-radius:8px; border:none; font-size:14px; font-weight:700;
    transition:.15s;
  }
  .btn-primary{ background:var(--ink); color:#fff; width:100%; }
  .btn-primary:hover{ background:var(--ink-soft); }
  .btn-ghost{ background:transparent; color:var(--slate); border:1px solid var(--line); }
  .btn-ghost:hover{ border-color:var(--slate-soft); color:var(--ink); }
  .btn-brass{ background:var(--brass); color:#fff; }
  .btn-brass:hover{ background:var(--brass-dark); }
  .btn-danger-outline{ background:transparent; color:var(--rust); border:1px solid var(--rust-bg); }
  .btn-danger-outline:hover{ background:var(--rust-bg); }
  .btn-sm{ padding:6px 12px; font-size:12.5px; border-radius:6px; }

  .auth-note{ font-size:12px; color:var(--slate-soft); margin-top:16px; line-height:1.7; text-align:center;}
  .auth-error{ background:var(--rust-bg); color:var(--rust); font-size:13px; padding:10px 12px; border-radius:8px; margin-bottom:14px; display:none; }
  .auth-error.show{ display:block; }

  /* ---------- App shell ---------- */
  #appScreen{ display:none; min-height:100vh; }
  #appScreen.show{ display:flex; }

  .sidebar{
    width:230px; flex-shrink:0; background:var(--ink); color:#fff;
    display:flex; flex-direction:column; padding:24px 16px;
    position:sticky; top:0; height:100vh;
  }
  .sidebar .brand{ padding:0 6px; margin-bottom:32px; }
  .sidebar .brand-mark{ border-color:rgba(255,255,255,0.4); color:#fff; }
  .sidebar .brand-text h1{ color:#fff; }
  .sidebar .brand-text p{ color:rgba(255,255,255,0.5); }

  .nav-item{
    display:flex; align-items:center; gap:11px; padding:11px 12px; border-radius:8px;
    background:none; border:none; color:rgba(255,255,255,0.65); font-size:14px; font-weight:500;
    text-align:right; width:100%; margin-bottom:4px; transition:.15s;
  }
  .nav-item .dot{ width:6px; height:6px; border-radius:50%; background:currentColor; opacity:0; transition:.15s; flex-shrink:0;}
  .nav-item:hover{ background:rgba(255,255,255,0.06); color:#fff; }
  .nav-item.active{ background:rgba(169,130,76,0.18); color:#fff; }
  .nav-item.active .dot{ opacity:1; background:var(--brass); }

  .sidebar-footer{ margin-top:auto; padding-top:16px; border-top:1px solid rgba(255,255,255,0.1); }
  .user-chip{ display:flex; align-items:center; gap:10px; margin-bottom:12px; }
  .user-avatar{
    width:34px; height:34px; border-radius:50%; background:var(--brass); color:#fff;
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; flex-shrink:0;
    font-family:var(--font-display);
  }
  .user-chip .uname{ font-size:13px; font-weight:600; }
  .user-chip .urole{ font-size:11px; color:rgba(255,255,255,0.5); }
  .logout-btn{
    width:100%; background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.75);
    border:1px solid rgba(255,255,255,0.1); border-radius:8px; padding:8px; font-size:12.5px;
  }
  .logout-btn:hover{ background:rgba(255,255,255,0.12); color:#fff; }

  .main{ flex:1; min-width:0; padding:28px 34px 60px; }
  .page{ display:none; }
  .page.active{ display:block; animation:fadeIn .25s ease; }
  @keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

  .page-header{ display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:26px; flex-wrap:wrap; gap:12px;}
  .page-header h2{ font-family:var(--font-display); font-size:26px; font-weight:900; }
  .page-header .sub{ font-size:13px; color:var(--slate); margin-top:4px; }
  .eyebrow{ font-family:var(--font-mono); font-size:11px; letter-spacing:1.5px; color:var(--brass); text-transform:uppercase; margin-bottom:6px; }

  /* ---------- Dashboard stat cards ---------- */
  .stat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px; margin-bottom:30px; }
  .stat-card{ background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:18px 20px; }
  .stat-card .label{ font-size:12.5px; color:var(--slate); margin-bottom:10px; }
  .stat-card .value{ font-family:var(--font-mono); font-size:30px; font-weight:700; color:var(--ink); }
  .stat-card .value span{ font-size:14px; color:var(--slate-soft); font-weight:400; }
  .stat-card.brass{ border-color:rgba(169,130,76,0.35); }
  .stat-card.brass .value{ color:var(--brass-dark); }

  .panel{ background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:22px; margin-bottom:20px; }
  .panel-title{ font-family:var(--font-display); font-weight:700; font-size:16px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between; }

  /* ---------- Toolbar / filters ---------- */
  .toolbar{ display:flex; flex-wrap:wrap; gap:10px; margin-bottom:18px; align-items:center; }
  .toolbar select, .toolbar input{ padding:9px 12px; border:1px solid var(--line); border-radius:7px; font-size:13px; background:var(--panel); }
  .toolbar input{ min-width:180px; }
  .spacer{ flex:1; }

  /* ---------- Cards list (offers/requests) ---------- */
  .record-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
  .record-card{ background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:18px; position:relative; transition:.15s; }
  .record-card:hover{ border-color:var(--slate-soft); box-shadow:0 8px 24px -16px rgba(23,32,51,0.3); }
  .record-top{ display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
  .record-type{ font-family:var(--font-display); font-weight:700; font-size:16px; }
  .record-id{ font-family:var(--font-mono); font-size:10.5px; color:var(--slate-soft); }
  .badge{ font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; white-space:nowrap; }
  .badge-available, .badge-active{ background:var(--emerald-bg); color:var(--emerald); }
  .badge-reserved, .badge-pending{ background:var(--amber-bg); color:var(--amber); }
  .badge-sold, .badge-closed{ background:var(--rust-bg); color:var(--rust); }
  .badge-draft{ background:var(--line-soft); color:var(--slate); border:1px dashed var(--line); font-weight:700; padding:4px 10px; }
  .record-price{ font-family:var(--font-mono); font-size:19px; font-weight:700; color:var(--brass-dark); margin:8px 0 12px; }
  .record-price small{ font-size:12px; color:var(--slate-soft); font-weight:400; font-family:var(--font-body); }
  .record-meta{ display:flex; flex-wrap:wrap; gap:6px 14px; font-size:12.5px; color:var(--slate); margin-bottom:12px; }
  .record-meta b{ color:var(--ink); font-weight:600; }
  .record-contact{ font-size:12.5px; color:var(--slate); border-top:1px dashed var(--line); padding-top:10px; margin-top:4px; }
  .record-contact .role-tag{ display:inline-block; font-size:10.5px; background:var(--line-soft); color:var(--slate); padding:2px 8px; border-radius:5px; margin-right:6px; }
  .record-actions{ display:flex; gap:8px; margin-top:14px; }
  .record-note{ font-size:12px; color:var(--slate-soft); margin-top:8px; font-style:italic; }
  .added-by{ font-size:10.5px; color:var(--slate-soft); margin-top:10px; font-family:var(--font-mono); }

  .empty-state{ text-align:center; padding:60px 20px; color:var(--slate-soft); }
  .empty-state .icon{ font-size:34px; margin-bottom:12px; }
  .empty-state h3{ font-family:var(--font-display); color:var(--ink); font-size:17px; margin-bottom:6px; }
  .empty-state p{ font-size:13px; margin-bottom:18px; }

  /* ---------- Modal / form ---------- */
  .modal-overlay{ display:none; position:fixed; inset:0; background:rgba(23,32,51,0.5); z-index:50; align-items:center; justify-content:center; padding:20px; backdrop-filter:blur(2px); }
  .modal-overlay.show{ display:flex; }
  .modal{ background:var(--panel); border-radius:14px; width:100%; max-width:620px; max-height:88vh; overflow-y:auto; padding:28px 30px; }
  .modal-header{ display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .modal-header h3{ font-family:var(--font-display); font-size:19px; font-weight:800; }
  .modal-close{ background:none; border:none; font-size:20px; color:var(--slate-soft); line-height:1; }
  .modal-close:hover{ color:var(--ink); }
  .form-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px 16px; }
  .form-grid .full{ grid-column:1/-1; }
  .modal-actions{ display:flex; gap:10px; margin-top:22px; justify-content:flex-end; }

  /* ---------- Matching page ---------- */
  .match-group{ background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); padding:20px; margin-bottom:16px; }
  .match-req-head{ display:flex; justify-content:space-between; align-items:flex-start; gap:14px; margin-bottom:14px; padding-bottom:14px; border-bottom:1px solid var(--line-soft); }
  .match-req-head .rtitle{ font-family:var(--font-display); font-weight:700; font-size:15.5px; }
  .match-req-head .rsub{ font-size:12px; color:var(--slate); margin-top:4px; }
  .match-list{ display:flex; flex-direction:column; gap:10px; }
  .match-row{ display:flex; align-items:center; gap:16px; padding:12px 14px; background:var(--paper); border-radius:9px; border:1px solid var(--line-soft); }
  .stamp{
    width:56px; height:56px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; flex-direction:column;
    border:2px dashed var(--brass); color:var(--brass-dark);
    font-family:var(--font-display); transform:rotate(-6deg);
  }
  .stamp .pct{ font-weight:900; font-size:15px; line-height:1; }
  .stamp .lbl{ font-size:7px; letter-spacing:0.5px; }
  .stamp.low{ border-color:var(--slate-soft); color:var(--slate); }
  .stamp.mid{ border-color:var(--amber); color:var(--amber); }
  .stamp.high{ border-color:var(--emerald); color:var(--emerald); }
  .match-row-info{ flex:1; min-width:0; }
  .match-row-info .mtitle{ font-weight:700; font-size:14px; }
  .match-row-info .mmeta{ font-size:12px; color:var(--slate); margin-top:3px; }
  .match-reasons{ display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
  .reason-chip{ font-size:10.5px; background:var(--emerald-bg); color:var(--emerald); padding:2px 8px; border-radius:5px; }
  .reason-chip.weak{ background:var(--line-soft); color:var(--slate); }

  @media (max-width:880px){
    #appScreen.show{ flex-direction:column; }
    .sidebar{ width:100%; height:auto; position:relative; flex-direction:row; align-items:center; padding:14px 16px; overflow-x:auto; }
    .sidebar .brand{ margin-bottom:0; }
    .sidebar-footer{ display:none; }
    .nav-item{ width:auto; white-space:nowrap; }
    .main{ padding:20px; }
    .form-grid{ grid-template-columns:1fr; }
  }
</style>
</head>
<body>

<!-- ===================== AUTH SCREEN ===================== -->
<div id="authScreen">
  <div class="auth-card">
    <div class="brand">
      <div class="brand-mark">س</div>
      <div class="brand-text">
        <h1>سجلّ</h1>
        <p>منصة العروض والطلبات العقارية الداخلية</p>
      </div>
    </div>

    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLoginBtn" onclick="switchAuthTab('login')">تسجيل الدخول</button>
      <button class="auth-tab" id="tabRegisterBtn" onclick="switchAuthTab('register')">حساب موظف جديد</button>
    </div>

    <div class="auth-error" id="authError"></div>

    <!-- login form -->
    <form id="loginForm" onsubmit="handleLogin(event)">
      <div class="field">
        <label>اسم المستخدم</label>
        <input type="text" id="loginUsername" required autocomplete="username">
      </div>
      <div class="field">
        <label>كلمة المرور</label>
        <input type="password" id="loginPassword" required autocomplete="current-password">
      </div>
      <button class="btn btn-primary" type="submit">دخول</button>
    </form>

    <!-- register form -->
    <form id="registerForm" style="display:none" onsubmit="handleRegister(event)">
      <div class="field">
        <label>الاسم الكامل</label>
        <input type="text" id="regName" required>
      </div>
      <div class="field">
        <label>اسم المستخدم</label>
        <input type="text" id="regUsername" required>
      </div>
      <div class="field">
        <label>كلمة المرور</label>
        <input type="password" id="regPassword" required minlength="4">
      </div>
      <button class="btn btn-brass" type="submit" style="width:100%">إنشاء الحساب والدخول</button>
    </form>

    <p class="auth-note">البيانات مشتركة بين جميع الموظفين المسجّلين في هذا الموقع.<br>يُنصح بعدم استخدام كلمة مرور حسّاسة تستخدمها في مواقع أخرى.</p>
  </div>
</div>

<!-- ===================== APP SCREEN ===================== -->
<div id="appScreen">
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark">س</div>
      <div class="brand-text">
        <h1>سجلّ</h1>
        <p>تسويق عقاري</p>
      </div>
    </div>

    <nav>
      <button class="nav-item active" data-page="dashboard" onclick="goPage('dashboard')"><span class="dot"></span> لوحة التحكم</button>
      <button class="nav-item" data-page="offers" onclick="goPage('offers')"><span class="dot"></span> العروض</button>
      <button class="nav-item" data-page="requests" onclick="goPage('requests')"><span class="dot"></span> الطلبات</button>
      <button class="nav-item" data-page="matches" onclick="goPage('matches')"><span class="dot"></span> المطابقات</button>
      <button class="nav-item" data-page="drafts" onclick="goPage('drafts')"><span class="dot"></span> المسودات</button>
    </nav>

    <div class="sidebar-footer">
      <div class="user-chip">
        <div class="user-avatar" id="sbAvatar">؟</div>
        <div>
          <div class="uname" id="sbName">—</div>
          <div class="urole">موظف مسوّق</div>
        </div>
      </div>
      <button class="logout-btn" onclick="handleLogout()">تسجيل الخروج</button>
    </div>
  </aside>

  <main class="main">

    <!-- ---------------- DASHBOARD ---------------- -->
    <section class="page active" id="page-dashboard">
      <div class="page-header">
        <div>
          <div class="eyebrow">نظرة عامة</div>
          <h2>لوحة التحكم</h2>
          <div class="sub">ملخص العروض والطلبات المسجّلة في المنصة (المسودات محفوظة منفصلة)</div>
        </div>
      </div>

      <div class="stat-grid">
        <div class="stat-card"><div class="label">إجمالي العروض</div><div class="value" id="statOffers">0</div></div>
        <div class="stat-card brass"><div class="label">عروض متاحة</div><div class="value" id="statOffersAvailable">0</div></div>
        <div class="stat-card"><div class="label">إجمالي الطلبات</div><div class="value" id="statRequests">0</div></div>
        <div class="stat-card brass"><div class="label">طلبات نشطة</div><div class="value" id="statRequestsActive">0</div></div>
        <div class="stat-card"><div class="label">مطابقات قوية (٧٠٪+)</div><div class="value" id="statStrongMatches">0</div></div>
      </div>

      <div class="panel">
        <div class="panel-title">أحدث العروض المضافة</div>
        <div id="recentOffers" class="record-grid"></div>
      </div>
      <div class="panel">
        <div class="panel-title">أحدث الطلبات المضافة</div>
        <div id="recentRequests" class="record-grid"></div>
      </div>
    </section>

    <!-- ---------------- OFFERS ---------------- -->
    <section class="page" id="page-offers">
      <div class="page-header">
        <div>
          <div class="eyebrow">قاعدة البيانات</div>
          <h2>العروض العقارية</h2>
          <div class="sub" id="offersCountSub">٠ عرض مسجّل</div>
        </div>
        <button class="btn btn-brass" onclick="openOfferModal()">+ إضافة عرض جديد</button>
      </div>

      <div class="toolbar">
        <select id="filterOfferType" onchange="renderOffers()">
          <option value="">كل الأنواع</option>
        </select>
        <select id="filterOfferStatus" onchange="renderOffers()">
          <option value="">كل الحالات</option>
          <option value="متاح">متاح</option>
          <option value="محجوز">محجوز</option>
          <option value="مباع">مباع</option>
        </select>
        <input type="text" id="filterOfferSearch" placeholder="بحث بالحي / المخطط / المالك..." oninput="renderOffers()">
        <div class="spacer"></div>
      </div>

      <div id="offersList" class="record-grid"></div>
    </section>

    <!-- ---------------- REQUESTS ---------------- -->
    <section class="page" id="page-requests">
      <div class="page-header">
        <div>
          <div class="eyebrow">قاعدة البيانات</div>
          <h2>طلبات العملاء</h2>
          <div class="sub" id="requestsCountSub">٠ طلب مسجّل</div>
        </div>
        <button class="btn btn-brass" onclick="openRequestModal()">+ إضافة طلب جديد</button>
      </div>

      <div class="toolbar">
        <select id="filterReqType" onchange="renderRequests()">
          <option value="">كل الأنواع</option>
        </select>
        <select id="filterReqStatus" onchange="renderRequests()">
          <option value="">كل الحالات</option>
          <option value="نشط">نشط</option>
          <option value="معلق">معلق</option>
          <option value="تم الإغلاق">تم الإغلاق</option>
        </select>
