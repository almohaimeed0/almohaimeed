    notes: document.getElementById('reqNotes').value.trim(),
  };
  if(id){
    const idx = requests.findIndex(r=>r.id===id);
    requests[idx] = {...requests[idx], ...data};
  }else{
    requests.push({ id: uid(), ...data, addedByName: currentUser.name, addedById: currentUser.id, createdAt: Date.now() });
