<script>
/* =====================================================================
   STATE
===================================================================== */
let currentUser = null;   // {id, username, name}
let users = [];
let offers = [];
let requests = [];
const PROPERTY_TYPES = ["شقة","فيلا","دور","أرض","عمارة","محل تجاري","مكتب","استراحة","مستودع"];

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,8); }
function simpleHash(str){
  // Not cryptographic security - just avoids storing raw passwords in plain sight.
  let h = 0;
  for(let i=0;i<str.length;i++){ h = (Math.imul(31,h) + str.charCodeAt(i))|0; }
  return 'h'+h.toString(36)+str.length;
}
function fmtMoney(n){ return Number(n).toLocaleString('en-US'); }
function escapeHtml(s){ return (s||'').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

/* =====================================================================
   STORAGE
===================================================================== */
async function loadAll(){
  try{
    const u = await window.storage.get('users', true);
    users = u ? JSON.parse(u.value) : [];
  }catch(e){ users = []; }
  try{
    const o = await window.storage.get('offers', true);
    offers = o ? JSON.parse(o.value) : [];
  }catch(e){ offers = []; }
  try{
    const r = await window.storage.get('requests', true);
    requests = r ? JSON.parse(r.value) : [];
  }catch(e){ requests = []; }
}
async function saveUsers(){
  try{ await window.storage.set('users', JSON.stringify(users), true); }
  catch(e){ console.error('storage error (users)', e); alert('تعذّر حفظ بيانات المستخدمين، حاول مجددًا.'); }
}
async function saveOffers(){
  try{ await window.storage.set('offers', JSON.stringify(offers), true); }
  catch(e){ console.error('storage error (offers)', e); alert('تعذّر حفظ العرض، حاول مجددًا.'); }
}
async function saveRequests(){
  try{ await window.storage.set('requests', JSON.stringify(requests), true); }
  catch(e){ console.error('storage error (requests)', e); alert('تعذّر حفظ الطلب، حاول مجددًا.'); }
}

/* =====================================================================
   AUTH
===================================================================== */
function switchAuthTab(tab){
  document.getElementById('tabLoginBtn').classList.toggle('active', tab==='login');
  document.getElementById('tabRegisterBtn').classList.toggle('active', tab==='register');
  document.getElementById('loginForm').style.display = tab==='login' ? 'block':'none';
  document.getElementById('registerForm').style.display = tab==='register' ? 'block':'none';
  hideAuthError();
}
function showAuthError(msg){
  const el = document.getElementById('authError');
  el.textContent = msg; el.classList.add('show');
}
function hideAuthError(){ document.getElementById('authError').classList.remove('show'); }

async function handleLogin(e){
  e.preventDefault();
  hideAuthError();
  const username = document.getElementById('loginUsername').value.trim();
  const password = document.getElementById('loginPassword').value;
  const found = users.find(u => u.username.toLowerCase() === username.toLowerCase());
  if(!found || found.passwordHash !== simpleHash(password)){
    showAuthError('اسم المستخدم أو كلمة المرور غير صحيحة.');
    return;
  }
  currentUser = found;
  enterApp();
}

async function handleRegister(e){
  e.preventDefault();
  hideAuthError();
  const name = document.getElementById('regName').value.trim();
  const username = document.getElementById('regUsername').value.trim();
  const password = document.getElementById('regPassword').value;
  if(users.find(u => u.username.toLowerCase() === username.toLowerCase())){
    showAuthError('اسم المستخدم هذا محجوز مسبقًا، اختر اسمًا آخر.');
    return;
  }
  const newUser = { id: uid(), name, username, passwordHash: simpleHash(password), createdAt: Date.now() };
  users.push(newUser);
  await saveUsers();
  currentUser = newUser;
  enterApp();
}

function handleLogout(){
  currentUser = null;
  document.getElementById('appScreen').classList.remove('show');
  document.getElementById('authScreen').style.display = 'flex';
  document.getElementById('loginForm').reset();
  document.getElementById('registerForm').reset();
  switchAuthTab('login');
}

function enterApp(){
  document.getElementById('authScreen').style.display = 'none';
  document.getElementById('appScreen').classList.add('show');
  document.getElementById('sbName').textContent = currentUser.name;
  document.getElementById('sbAvatar').textContent = currentUser.name.trim().charAt(0);
  populateTypeFilters();
  renderAll();
}

/* =====================================================================
   NAVIGATION
===================================================================== */
function goPage(page){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+page).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.page===page));
  if(page==='matches') renderMatches();
  if(page==='drafts') renderDrafts();
}

function populateTypeFilters(){
  const opts = PROPERTY_TYPES.map(t=>`<option>${t}</option>`).join('');
  document.getElementById('filterOfferType').innerHTML = '<option value="">كل الأنواع</option>' + opts;
  document.getElementById('filterReqType').innerHTML = '<option value="">كل الأنواع</option>' + opts;
}

/* =====================================================================
   RENDER: DASHBOARD
   Exclude drafts from main counts/lists
===================================================================== */
function renderAll(){
  renderDashboard();
  renderOffers();
  renderRequests();
  renderDrafts();
}

function renderDashboard(){
  const publishedOffers = offers.filter(o=>o.status!=='مسودة');
  const publishedRequests = requests.filter(r=>r.status!=='مسودة');
  document.getElementById('statOffers').textContent = publishedOffers.length;
  document.getElementById('statOffersAvailable').textContent = publishedOffers.filter(o=>o.status==='متاح').length;
  document.getElementById('statRequests').textContent = publishedRequests.length;
  document.getElementById('statRequestsActive').textContent = publishedRequests.filter(r=>r.status==='نشط').length;
  const allMatches = computeAllMatches();
  const strong = allMatches.reduce((acc,g)=> acc + g.matches.filter(m=>m.score>=70).length, 0);
  document.getElementById('statStrongMatches').textContent = strong;

  const recentOffers = [...offers].filter(o=>o.status!=='مسودة').sort((a,b)=>b.createdAt-a.createdAt).slice(0,3);
  const recentRequests = [...requests].filter(r=>r.status!=='مسودة').sort((a,b)=>b.createdAt-a.createdAt).slice(0,3);
  document.getElementById('recentOffers').innerHTML = recentOffers.length
    ? recentOffers.map(offerCardHtml).join('')
    : emptyStateHtml('لا توجد عروض بعد','ابدأ بإضافة أول عرض عقاري.');
  document.getElementById('recentRequests').innerHTML = recentRequests.length
    ? recentRequests.map(requestCardHtml).join('')
    : emptyStateHtml('لا توجد طلبات بعد','ابدأ بتسجيل أول طلب عميل.');
}

function emptyStateHtml(title, sub){
  return `<div class="empty-state" style="grid-column:1/-1">
    <div class="icon">＋</div>
    <h3>${title}</h3>
    <p>${sub}</p>
  </div>`;
}

/* =====================================================================
   RENDER: OFFERS
===================================================================== */
function statusBadgeClass(status){
  if(status==='مسودة') return 'badge-draft';
  if(status==='متاح'||status==='نشط') return 'badge-available';
  if(status==='محجوز'||status==='معلق') return 'badge-reserved';
  return 'badge-sold';
}

function offerCardHtml(o){
  return `
  <div class="record-card">
    <div class="record-top">
      <div>
        <div class="record-type">${escapeHtml(o.type)}</div>
        <div class="record-id">#${o.id.slice(-6)}</div>
      </div>
      <span class="badge ${statusBadgeClass(o.status)}">${escapeHtml(o.status)}</span>
    </div>
    <div class="record-price">${fmtMoney(o.price)} <small>ريال</small></div>
    <div class="record-meta">
      <span>📐 <b>${fmtMoney(o.area)}</b> م²</span>
      <span>📍 <b>${escapeHtml(o.city)}</b> — ${escapeHtml(o.neighborhood)}</span>
      ${o.plan ? `<span>🗺️ ${escapeHtml(o.plan)}</span>` : ''}
    </div>
    <div class="record-contact">
      <span class="role-tag">${escapeHtml(o.role)}</span>
      ${escapeHtml(o.ownerName)} — ${escapeHtml(o.ownerPhone)}
    </div>
    ${o.notes ? `<div class="record-note">"${escapeHtml(o.notes)}"</div>` : ''}
    <div class="added-by">أضيف بواسطة ${escapeHtml(o.addedByName)} · ${new Date(o.createdAt).toLocaleDateString('ar-SA')}</div>
    <div class="record-actions">
      <button class="btn btn-ghost btn-sm" onclick="editOffer('${o.id}')">تعديل</button>
      ${o.status==='مسودة' ? `<button class="btn btn-brass btn-sm" onclick="publishOffer('${o.id}')">نشر</button>` : ''}
      <button class="btn btn-danger-outline btn-sm" onclick="deleteOffer('${o.id}')">حذف</button>
    </div>
  </div>`;
}

function renderOffers(){
  const type = document.getElementById('filterOfferType').value;
  const status = document.getElementById('filterOfferStatus').value;
  const search = document.getElementById('filterOfferSearch').value.trim().toLowerCase();

  // show only non-draft published offers here
  let list = [...offers].filter(o=>o.status!=='مسودة').sort((a,b)=>b.createdAt-a.createdAt);
  if(type) list = list.filter(o=>o.type===type);
  if(status) list = list.filter(o=>o.status===status);
  if(search) list = list.filter(o =>
    o.neighborhood.toLowerCase().includes(search) ||
    (o.plan||'').toLowerCase().includes(search) ||
    o.ownerName.toLowerCase().includes(search) ||
    o.city.toLowerCase().includes(search)
  );

  const publishedCount = offers.filter(o=>o.status!=='مسودة').length;
  document.getElementById('offersCountSub').textContent = `${publishedCount} عرض مسجّل${type||status||search ? ' — ' + list.length + ' مطابق للفلترة' : ''}`;
  document.getElementById('offersList').innerHTML = list.length
    ? list.map(offerCardHtml).join('')
    : emptyStateHtml('لا توجد عروض مطابقة', 'جرّب تعديل الفلاتر أو أضف عرضًا جديدًا.');
}

function openOfferModal(){
  document.getElementById('offerForm').reset();
  document.getElementById('offerId').value = '';
  document.getElementById('offerModalTitle').textContent = 'إضافة عرض جديد';
  document.getElementById('offerModalOverlay').classList.add('show');
}
function closeOfferModal(){ document.getElementById('offerModalOverlay').classList.remove('show'); }

function editOffer(id){
  const o = offers.find(x=>x.id===id);
  if(!o) return;
  document.getElementById('offerId').value = o.id;
  document.getElementById('offerType').value = o.type;
  document.getElementById('offerStatus').value = o.status;
  document.getElementById('offerArea').value = o.area;
  document.getElementById('offerPrice').value = o.price;
  document.getElementById('offerCity').value = o.city;
  document.getElementById('offerNeighborhood').value = o.neighborhood;
  document.getElementById('offerPlan').value = o.plan || '';
  document.getElementById('offerOwnerName').value = o.ownerName;
  document.getElementById('offerOwnerPhone').value = o.ownerPhone;
  document.getElementById('offerRole').value = o.role;
  document.getElementById('offerNotes').value = o.notes || '';
  document.getElementById('offerModalTitle').textContent = o.status==='مسودة' ? 'تعديل مسودة العرض' : 'تعديل العرض';
  document.getElementById('offerModalOverlay').classList.add('show');
}

async function saveOffer(e){
  e.preventDefault();
  const id = document.getElementById('offerId').value;
  const data = {
    type: document.getElementById('offerType').value,
    status: document.getElementById('offerStatus').value,
    area: Number(document.getElementById('offerArea').value),
    price: Number(document.getElementById('offerPrice').value),
    city: document.getElementById('offerCity').value.trim(),
    neighborhood: document.getElementById('offerNeighborhood').value.trim(),
    plan: document.getElementById('offerPlan').value.trim(),
    ownerName: document.getElementById('offerOwnerName').value.trim(),
    ownerPhone: document.getElementById('offerOwnerPhone').value.trim(),
    role: document.getElementById('offerRole').value,
    notes: document.getElementById('offerNotes').value.trim(),
  };
  if(id){
    const idx = offers.findIndex(o=>o.id===id);
    offers[idx] = {...offers[idx], ...data};
  }else{
    offers.push({ id: uid(), ...data, addedByName: currentUser.name, addedById: currentUser.id, createdAt: Date.now() });
  }
  await saveOffers();
  closeOfferModal();
  renderOffers();
  renderDashboard();
  renderDrafts();
}

async function saveOfferDraft(){
  // collect values but force status to "مسودة"
  const id = document.getElementById('offerId').value;
  const data = {
    type: document.getElementById('offerType').value,
    status: 'مسودة',
    area: Number(document.getElementById('offerArea').value) || null,
    price: Number(document.getElementById('offerPrice').value) || null,
    city: document.getElementById('offerCity').value.trim(),
    neighborhood: document.getElementById('offerNeighborhood').value.trim(),
    plan: document.getElementById('offerPlan').value.trim(),
    ownerName: document.getElementById('offerOwnerName').value.trim(),
    ownerPhone: document.getElementById('offerOwnerPhone').value.trim(),
    role: document.getElementById('offerRole').value,
    notes: document.getElementById('offerNotes').value.trim(),
  };
  if(id){
    const idx = offers.findIndex(o=>o.id===id);
    offers[idx] = {...offers[idx], ...data};
  }else{
    offers.push({ id: uid(), ...data, addedByName: currentUser.name, addedById: currentUser.id, createdAt: Date.now() });
  }
  await saveOffers();
  closeOfferModal();
  renderOffers();
  renderDashboard();
  renderDrafts();
}

async function deleteOffer(id){
  if(!confirm('هل تريد حذف هذا العرض نهائيًا؟')) return;
  offers = offers.filter(o=>o.id!==id);
  await saveOffers();
  renderOffers();
  renderDashboard();
  renderDrafts();
}

async function publishOffer(id){
  const idx = offers.findIndex(o=>o.id===id);
  if(idx === -1) return;
  offers[idx].status = 'متاح';
  await saveOffers();
  renderOffers();
  renderDashboard();
  renderDrafts();
}

/* =====================================================================
   RENDER: REQUESTS
===================================================================== */
function requestCardHtml(r){
  const areaRange = (r.areaMin || r.areaMax) ? `${r.areaMin?fmtMoney(r.areaMin):'—'} - ${r.areaMax?fmtMoney(r.areaMax):'—'} م²` : 'غير محدد';
  return `
  <div class="record-card">
    <div class="record-top">
      <div>
        <div class="record-type">${escapeHtml(r.type)}</div>
        <div class="record-id">#${r.id.slice(-6)}</div>
      </div>
      <span class="badge ${statusBadgeClass(r.status)}">${escapeHtml(r.status)}</span>
    </div>
    <div class="record-price">حتى ${fmtMoney(r.budgetMax)} <small>ريال${r.budgetMin ? ' (من '+fmtMoney(r.budgetMin)+')' : ''}</small></div>
    <div class="record-meta">
      <span>📐 ${areaRange}</span>
      <span>📍 <b>${escapeHtml(r.city)}</b>${r.neighborhood ? ' — ' + escapeHtml(r.neighborhood) : ' — أي حي'}</span>
    </div>
    <div class="record-contact">
      <span class="role-tag">${escapeHtml(r.role)}</span>
      ${escapeHtml(r.clientName)} — ${escapeHtml(r.clientPhone)}
    </div>
    ${r.notes ? `<div class="record-note">"${escapeHtml(r.notes)}"</div>` : ''}
    <div class="added-by">أضيف بواسطة ${escapeHtml(r.addedByName)} · ${new Date(r.createdAt).toLocaleDateString('ar-SA')}</div>
    <div class="record-actions">
      <button class="btn btn-ghost btn-sm" onclick="editRequest('${r.id}')">تعديل</button>
      ${r.status==='مسودة' ? `<button class="btn btn-brass btn-sm" onclick="publishRequest('${r.id}')">نشر</button>` : ''}
      <button class="btn btn-danger-outline btn-sm" onclick="deleteRequest('${r.id}')">حذف</button>
    </div>
  </div>`;
}

function renderRequests(){
  const type = document.getElementById('filterReqType').value;
  const status = document.getElementById('filterReqStatus').value;
  const search = document.getElementById('filterReqSearch').value.trim().toLowerCase();

  // show only non-draft published requests here
  let list = [...requests].filter(r=>r.status!=='مسودة').sort((a,b)=>b.createdAt-a.createdAt);
  if(type) list = list.filter(r=>r.type===type);
  if(status) list = list.filter(r=>r.status===status);
  if(search) list = list.filter(r =>
    (r.neighborhood||'').toLowerCase().includes(search) ||
    r.clientName.toLowerCase().includes(search) ||
    r.city.toLowerCase().includes(search)
  );

  const publishedCount = requests.filter(r=>r.status!=='مسودة').length;
  document.getElementById('requestsCountSub').textContent = `${publishedCount} طلب مسجّل${type||status||search ? ' — ' + list.length + ' مطابق للفلترة' : ''}`;
  document.getElementById('requestsList').innerHTML = list.length
    ? list.map(requestCardHtml).join('')
    : emptyStateHtml('لا توجد طلبات مطابقة', 'جرّب تعديل الفلاتر أو أضف طلبًا جديدًا.');
}

